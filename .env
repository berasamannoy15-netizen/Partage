# ─── Cloudinary Video Upload (FREE tier) ───────────────────────────────────────
# 1. Go to https://cloudinary.com and sign up for free
# 2. In your Cloudinary dashboard, find your "Cloud Name" (top-left of console)
# 3. Go to Settings → Upload → Add upload preset → choose "Unsigned" → save
# 4. Paste both values below, then restart the dev server (npm run dev)

VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_here
